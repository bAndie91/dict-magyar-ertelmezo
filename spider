#!/bin/bash

set -euo pipefail

. /usr/lib/tool/bash-utils

kezdobetu=$1
szo=$2
szo_urlenc=`echo -n "$szo" | url_encode`

mkdir -p szavak/$kezdobetu/

while true
do
	url="https://ertelmezo.oszk.hu/szotar.php?szo=$szo_urlenc&kezdobetu=$kezdobetu"
	
	warnx "get $url"
	page=`curl -sSf "$url"`
		
	echo "$szo"
	echo "$page" |\
		parsel ".col-md-10 .szocikk" |\
		lines 2 | sed -e 's/\\\\/\\/g; s/\\r/\r/g; s/\\n/\n/g' |\
		tee szavak/$kezdobetu/"$szo".html >/dev/null
	
	next=`echo "$page" |\
		parsel @.col-md-10 / @.pagination / @"li:nth-child(2)" / @a attr{href} |\
		lines 2`
	
	if [ "$next" = "#" ]; then exit 0; fi
	
	[[ $next =~ szo=([^&]+) ]]
	next_szo_urlenc=${BASH_REMATCH[1]}
	next_szo=`echo -n "$next_szo_urlenc" | sd '\+' ' ' | url_decode`
	
	if [ "$szo" = "$next_szo" ]
	then
		errx 2 "'$szo' után ugyanaz a szó jön"
	fi
	
	szo_urlenc=$next_szo_urlenc
	szo=$next_szo
done
